<?xml version="1.0" encoding="utf-8"?>
<mdscript name="LeapOfFaithJumpEngineMod" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>

    <!--
      Init. Fires on every load (md.Setup.Start). Resolves the sectors/anomaly objects.
    -->
    <cue name="LeapOfFaithJumpEngineMod_Init" mapeditor="false">
      <conditions>
        <event_cue_signalled cue="md.Setup.Start"/>
      </conditions>
      <actions>
        <find_sector name="$SectorAvarice" macro="macro.cluster_500_sector002_macro" required="false"/>
        <find_sector name="$SectorLeapOfFaith" macro="macro.cluster_504_sector001_macro" required="false"/>
        <do_if value="$SectorAvarice? and $SectorLeapOfFaith?">
          <find_object name="$AnomalyAvarice" class="class.anomaly" space="$SectorAvarice" multiple="false" godobjectentry="'S2B_anomaly_01'" required="false"/>
          <find_object name="$AnomalyLeapOfFaith" class="class.anomaly" space="$SectorLeapOfFaith" multiple="false" godobjectentry="'S3_anomaly_01'" required="false"/>
        </do_if>
        <!--
          event_object_entered_anomaly needs an "object" or "group" attribute to watch (entry/exit
          only filter which anomaly). $PlayerOwnedShips is a galaxy-wide group of player-owned
          ships, refreshed periodically below - group membership can change after the event
          condition is set up.
        -->
        <create_group groupname="$PlayerOwnedShips"/>
        <find_ship groupname="$PlayerOwnedShips" owner="faction.player" space="player.galaxy" multiple="true"/>
        <!--
          Re-arm CollectJumpData/Correct_FromAvarice synchronously, right after $PlayerOwnedShips
          exists - avoids a window where their event condition would still reference an invalid
          group from script-load time. The checkinterval versions below handle the case where the
          plot/research complete later in the same session.
        -->
        <do_if value="LeapOfFaithJumpEngineMod_CollectJumpData.state != cuestate.complete">
          <reset_cue cue="LeapOfFaithJumpEngineMod_CollectJumpData"/>
        </do_if>
        <do_if value="ware.research_mod_engine_leap_of_faith_jump.research.unlocked">
          <reset_cue cue="LeapOfFaithJumpEngineMod_Correct_FromAvarice"/>
        </do_if>
      </actions>

      <cues>
        <!--
          Keeps $PlayerOwnedShips in sync with newly bought/built or lost/sold ships. Runs forever
          - needed by CollectJumpData during the counting phase, then by Correct_FromAvarice for
          the rest of the game.
        -->
        <cue name="LeapOfFaithJumpEngineMod_RefreshPlayerShips" checkinterval="5s">
          <conditions>
            <check_value value="LeapOfFaithJumpEngineMod_Init.state == cuestate.complete"/>
          </conditions>
          <actions>
            <clear_group group="$PlayerOwnedShips"/>
            <find_ship groupname="$PlayerOwnedShips" owner="faction.player" space="player.galaxy" multiple="true"/>
          </actions>
          <delay min="10s" max="60s"/>
          <actions>
            <reset_cue cue="this"/>
          </actions>
        </cue>

        <!--
          Boso Ta's jump-data storyline: counts jumps by any player-owned ship from Avarice to 
          Leap of Faith, only once the Northriver Plot is done.
          Ch10_Epilogue is used instead of Ch10_Finished, which can show state cancelled even on a
          completed playthrough - mirrors Egosoft's own equivalent check in story_thefan.xml.

          - 1st qualifying jump: Boso Ta notices a pattern (message 200/201).
          - 5th qualifying jump: Boso Ta has enough data, sends message 210/211 and reveals the
            research. Adjust the "ge 5" below to taste.

          $JumpCount is a local variable that persists across reset_cue (vanilla pattern, e.g.
          lib_dialog.xml's "$CurrentActor operation=add" + reset_cue cue="this").
        -->
        <cue name="LeapOfFaithJumpEngineMod_CollectJumpData_Init" mapeditor="false" checkinterval="5s">
          <conditions>
            <check_value value="LeapOfFaithJumpEngineMod_Init.state == cuestate.complete"/>
          </conditions>
          <actions>
            <!--
              Re-arms CollectJumpData now that $PlayerOwnedShips exists. Skipped if already
              complete, to avoid re-triggering the reveal message/encyclopedia entry on a save
              where the threshold was already reached.
            -->
            <do_if value="LeapOfFaithJumpEngineMod_CollectJumpData.state != cuestate.complete">
              <reset_cue cue="LeapOfFaithJumpEngineMod_CollectJumpData"/>
            </do_if>
          </actions>
          <cues>
            <cue name="LeapOfFaithJumpEngineMod_CollectJumpData" mapeditor="false">
              <conditions>
                <event_object_entered_anomaly entry="$AnomalyAvarice" group="$PlayerOwnedShips"/>
              </conditions>
              <actions>
                <do_if value="md.Story_Thefan.Ch10_Epilogue.exists and (md.Story_Thefan.Ch10_Epilogue.state == cuestate.complete or md.Story_Thefan.Ch10_Epilogue.state == cuestate.cancelled) and event.param2 == $AnomalyLeapOfFaith">
                  <set_value name="$JumpCount" operation="add" exact="1"/>
                  <do_if value="$JumpCount == 1">
                    <write_incoming_message highpriority="true" title="{9000001,200}" text="{9000001,201}" source="{9000001,202}"/>
                  </do_if>
                  <do_if value="$JumpCount ge 5">
                    <write_incoming_message highpriority="true" title="{9000001,210}" text="{9000001,211}" source="{9000001,202}"/>
                    <add_encyclopedia_entry type="researchables" item="'research_mod_engine_leap_of_faith_jump'"/>
                  </do_if>
                </do_if>
                <do_if value="not ($JumpCount? and $JumpCount ge 5)">
                  <reset_cue cue="this"/>
                </do_if>
              </actions>
            </cue>
          </cues>
        </cue>

        <!--
          Gameplay payoff: once the research is unlocked, a ship fitted with
          mod_engine_leap_of_faith_jump always reaches Leap of Faith, regardless of event.param2.
          We don't touch add_anomaly_destination: vanilla already guarantees Leap of Faith during
          the wave (only destination added then, so the "random" pick is trivial) and blocks it
          outside the wave (empty destinations, anomaly's own chaos fallback). Adding our own
          would leak it in as an option for every ship, not just modded ones. Correction is scoped
          to $PlayerOwnedShips since the mod is only obtainable by crafting.
        -->
        <cue name="LeapOfFaithJumpEngineMod_JumpCorrection_Init" checkinterval="20s">
          <conditions>
            <check_value value="LeapOfFaithJumpEngineMod_Init.state == cuestate.complete"/>
            <check_value value="ware.research_mod_engine_leap_of_faith_jump.research.unlocked"/>
          </conditions>
          <actions>
            <reset_cue cue="LeapOfFaithJumpEngineMod_Correct_FromAvarice"/>
          </actions>

          <cues>
            <cue name="LeapOfFaithJumpEngineMod_Correct_FromAvarice" instantiate="true">
              <conditions>
                <event_object_entered_anomaly entry="$AnomalyAvarice" group="$PlayerOwnedShips"/>
              </conditions>
              <actions>
                <check_object object="event.object" result="$HasJumpMod">
                  <match_engine_mod ware="ware.mod_engine_leap_of_faith_jump"/>
                </check_object>
                <do_if value="$HasJumpMod and event.param2 != $AnomalyLeapOfFaith">
                  <!--
                    Safe-warp distance scaled by ship size class - a bigger ship needs more
                    clearance to avoid overlapping the anomaly or anything docked/nearby.
                  -->
                  <do_if value="event.object.class == class.ship_xs">
                    <set_value name="$CorrectMin" exact="20m"/>
                    <set_value name="$CorrectMax" exact="50m"/>
                  </do_if>
                  <do_elseif value="event.object.class == class.ship_s">
                    <set_value name="$CorrectMin" exact="50m"/>
                    <set_value name="$CorrectMax" exact="150m"/>
                  </do_elseif>
                  <do_elseif value="event.object.class == class.ship_m">
                    <set_value name="$CorrectMin" exact="200m"/>
                    <set_value name="$CorrectMax" exact="500m"/>
                  </do_elseif>
                  <do_elseif value="event.object.class == class.ship_l">
                    <set_value name="$CorrectMin" exact="1km"/>
                    <set_value name="$CorrectMax" exact="3km"/>
                  </do_elseif>
                  <do_else comment="ship_xl or anything unexpected">
                    <set_value name="$CorrectMin" exact="2km"/>m
                    <set_value name="$CorrectMax" exact="5km"/>
                  </do_else>
                  <warp object="event.object" sector="$SectorLeapOfFaith">
                    <safepos object="$AnomalyLeapOfFaith" min="$CorrectMin" max="$CorrectMax"/>
                  </warp>
                </do_if>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

  </cues>
</mdscript>
