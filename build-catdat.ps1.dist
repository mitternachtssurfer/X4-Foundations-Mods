param(
    [string]$ModDir,
    [string]$XRCatToolPath = "",
    [string]$OutCat = "ext_01.cat",
    [string]$SrcPath,
    [switch]$Clean
)

$ErrorActionPreference = "Stop"

if (-not $PSBoundParameters.ContainsKey("ModDir") -or [string]::IsNullOrWhiteSpace($ModDir)) {
    $candidateDirs = Get-ChildItem -LiteralPath $PSScriptRoot -Directory | Sort-Object Name
    if (-not $candidateDirs) {
        throw "No subfolders under '$PSScriptRoot' found. Please specify -ModDir."
    }

    Write-Host "Please choose a mod directory:"
    for ($i = 0; $i -lt $candidateDirs.Count; $i++) {
        Write-Host (("{0}. {1}" -f ($i + 1), $candidateDirs[$i].Name))
    }

    [int]$selectedIndex = 0
    do {
        $selection = Read-Host "Enter number"
    } while (
        -not [int]::TryParse($selection, [ref]$selectedIndex) -or
        $selectedIndex -lt 1 -or
        $selectedIndex -gt $candidateDirs.Count
    )

    $ModDir = $candidateDirs[$selectedIndex - 1].FullName
}

if (-not $PSBoundParameters.ContainsKey("SrcPath") -or [string]::IsNullOrWhiteSpace($SrcPath)) {
    $SrcPath = Join-Path $ModDir "src"
}

if (-not (Test-Path -LiteralPath $XRCatToolPath)) {
    throw "XRCatTool not found: $XRCatToolPath"
}

if (-not (Test-Path -LiteralPath $ModDir)) {
    throw "Mod directory not found: $ModDir"
}

if (-not (Test-Path -LiteralPath $SrcPath)) {
    throw "Source directory not found: $SrcPath"
}

$OutCatPath = Join-Path $ModDir $OutCat
$OutDatPath = [System.IO.Path]::ChangeExtension($OutCatPath, ".dat")

if ($Clean) {
    if (Test-Path -LiteralPath $OutCatPath) {
        Remove-Item -LiteralPath $OutCatPath -Force
    }
    if (Test-Path -LiteralPath $OutDatPath) {
        Remove-Item -LiteralPath $OutDatPath -Force
    }
}

$includePattern = "^(assets|libraries|md|ui|t|extensions|aiscripts|maps|cutscenes|index|music|sfx)/"

Push-Location $ModDir
try {
    & $XRCatToolPath -in "$SrcPath" -out ".\$OutCat" -include $includePattern
    if ($LASTEXITCODE -ne 0) {
        throw "XRCatTool failed with ExitCode $LASTEXITCODE"
    }
}
finally {
    Pop-Location
}

if (-not (Test-Path -LiteralPath $OutCatPath) -or -not (Test-Path -LiteralPath $OutDatPath)) {
    throw "Packing completed, but CAT/DAT not fully generated."
}

Get-Item -LiteralPath $OutCatPath, $OutDatPath | Select-Object Name, Length, LastWriteTime
