<?xml version="1.0" encoding="utf-8"?>
<aiscript name="order.jump.anomaly" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd" version="1">
  <!--
    Custom order for "fly to an anomaly and jump through it". Queued directly
    (just this one order, nothing else) by src/md/order_jump_anomaly.xml
    (OrderJumpAnomaly_SendShip).

    Structured after Egosoft's own DockAndWait (aiscripts/order.dock.wait.xml):
    that order also shows as two order-list entries ("Dock"/"Dock and Wait")
    because it checks its own precondition (docked at the right destination?)
    every time it (re)starts, and if unmet, creates an immediate "DockAt"
    sub-order to fix that before proceeding - rather than trusting that a
    separate, once-only "get there" order already handled it. This matters
    because an order that gets interrupted (eg. a manually inserted order
    runs while this one is paused waiting to resume) *restarts from the top
    of its own script* once it becomes current again - it does not resume
    mid-flow. An earlier version of this order relied on a separate, once-only
    MoveToObject queued before it in MD, and would still fire
    perform_gate_transition after its wait even if a manually inserted order
    in between had since flown the ship somewhere else entirely - because it
    only checked its position once, whereas DockAndWait re-validates (and
    re-navigates if needed) on every single (re)start. This order copies that
    pattern.
  -->
  <!--
    Known limitation: this order cannot be used in a player-created repeat
    order loop. It never gets the loop numbering/count in the order list at
    all (unlike DockAndWait/MoveToObject), immediately on adding it - before
    it ever runs. menu_interactmenu.lua checks a native, compiled engine
    function (C.IsOrderLoopable(orderdefid)) to decide this per order id, and
    its internal logic isn't inspectable from any exported script/schema
    file. Tried and confirmed NOT to fix it: explicit allowinloop="true" on
    this <order> (schema default is already true when omitted), explicitly
    finishing via cancel_order keepinloop="true" instead of a natural script
    end, and adding the full standard interrupt handler set (kept below
    regardless, since those are a genuine correctness improvement on their
    own - see that comment). Outside of a loop, the order works normally.
  -->
  <order id="JumpAnomaly" name="{9000002, 20}" description="{9000002, 21}" category="navigation">
    <params>
      <param name="anomaly" type="object" text="{9000002, 22}" comment="Anomaly to transition through">
        <input_param name="class" value="[class.anomaly]"/>
      </param>
      <!--
        How close to the anomaly counts as arrived - checked in three places
        below, kept as one param instead of a repeated literal. Scaled by
        ship size (xs 500m, s 1km, m 2km, l 3km, xl/anything else 4km) since a
        bigger ship needs more clearance - same size-class scaling idea as
        leap_of_faith_jump_engine_mod's Lib_CorrectShipToDestination.
      -->
      <param name="arrivaldistance" type="internal" default="if this.ship.class == class.ship_xs then 500m else if this.ship.class == class.ship_s then 1km else if this.ship.class == class.ship_m then 2km else if this.ship.class == class.ship_l then 3km else 4km" comment="How close to the anomaly counts as arrived, scaled by ship size"/>
    </params>
    <requires>
      <match shiptype="shiptype.lasertower" negate="true"/>
      <match class="class.spacesuit" negate="true"/>
    </requires>
    <location object="$anomaly" condition="$anomaly.exists"/>
    <!--
      Without an explicit override, the map/order-list icon for a custom
      order id is looked up by a "order_" + lowercase(id) naming convention
      (eg. id="MoveToObject" -> icon "order_movetoobject", confirmed in
      libraries/icons.xml) - there is no "order_jumpanomaly" icon asset, so
      it fell back to a "?" placeholder. No dedicated jump/anomaly/gate order
      icon exists in vanilla either (checked icons.xml), so this reuses
      order_movetoobject - the same icon already used for the interact menu
      entry in src/md/order_jump_anomaly.xml.
    -->
    <icon name="order_movetoobject"/>
  </order>

  <!--
    Full standard interrupt handler set, matching both Egosoft's own orders
    (eg. order.move.wait.object.xml) and GS QoL: Jump and Wait
    (gs_qol_jump_and_wait's order.gs_qol_jump_and_wait.jumpwait, a similar
    "jump through a gate, then wait" custom order) - we had none of these
    before. Added while chasing the loop limitation above (it didn't fix
    that), but kept regardless: this order was missing standard handling for
    being attacked, scanned, inspected, finding an abandoned ship/lockbox
    mid-flight, resupply needs and tide effects, same as any other real
    order. In particular SectorChangeHandler reacts to this.ship entering an
    anomaly/gate (which our own perform_gate_transition call triggers) with
    "abort_called_scripts resume='start'" - see the $hasjumped guard at the
    "start" label below for why that needs handling, rather than just adding
    the handler and hoping.
  -->
  <interrupts>
    <handler ref="SectorChangeHandler"/>
    <handler ref="TargetInvalidHandler"/>
    <handler ref="AttackHandler"/>
    <handler ref="MissileLockHandler"/>
    <handler ref="ScannedHandler"/>
    <handler ref="InspectedHandler"/>
    <handler ref="FoundAbandonedHandler"/>
    <handler ref="FoundLockboxHandler"/>
    <handler ref="ResupplyHandler"/>
    <handler ref="TideHandler"/>
  </interrupts>

  <attention min="unknown">
    <actions>
      <label name="start"/>

      <!--
        SectorChangeHandler resumes here after perform_gate_transition below
        triggers event_object_entered_anomaly for our own jump (this.ship
        entering $anomaly counts, same as any other anomaly/gate entry) -
        without this guard, restarting from "start" would see the ship now
        in a different sector than $anomaly (the source-side anomaly) and
        wrongly re-trigger the "not near, fly there" branch, sending the ship
        all the way back. $hasjumped is a local script variable, expected to
        survive this resume (it is a resume within the same running script,
        not a fresh restart like the create_order-immediate case above/below).
      -->
      <do_if value="@$hasjumped">
        <!-- Nothing left to do - already jumped in a previous pass through this script. Chance=0: enable manually if this needs re-diagnosing. -->
        <debug_text text="'JumpAnomaly: already jumped, finishing.'" chance="0"/>
      </do_if>
      <do_elseif value="not $anomaly? or not $anomaly.exists">
        <debug_text text="'JumpAnomaly: no valid anomaly parameter, aborting.'" filter="error"/>
      </do_elseif>
      <do_else>
        <!--
          "Am I already there?" - re-checked every time this order (re)starts,
          not just once. 5km mirrors the beacon search radius on the MD side
          (OrderJumpAnomaly_Globals.$BeaconSearchRadius).
        -->
        <do_if value="not (this.ship.sector == $anomaly.sector and this.ship.relativeposition.{$anomaly}.length le $arrivaldistance)">
          <create_order object="this.ship" id="'MoveToObject'" immediate="true" comment="Not (or no longer) near the anomaly - fly there first, same as DockAndWait's own DockAt sub-order">
            <param name="destination" value="$anomaly"/>
            <param name="noattackresponse" value="true"/>
          </create_order>
          <wait exact="1ms"/>
        </do_if>

        <do_if value="this.ship.exists and $anomaly.exists and this.ship.sector == $anomaly.sector and this.ship.relativeposition.{$anomaly}.length le $arrivaldistance">
          <!--
            Min = 6 - (skill/3): using stars (skill/3, 0-5), not the raw 0-15
            skill value - 1s at 5 stars (skill 15) up to 6s at 0 stars
            (skill 0). Max = 3x Min, so the spread widens for a worse pilot
            too (1-3s at 5 stars, 6-18s at 0 stars). A ship with no assigned
            pilot (eg. the player's own occupied ship) is treated as
            worst-case (skill 0), since there's no crew skill to rely on.
          -->
          <set_value name="$pilotskill" exact="if this.ship.pilot.exists then this.ship.pilot.skill.piloting else 0"/>
          <set_value name="$delaymin" exact="6 - ($pilotskill / 3)"/>
          <set_value name="$delaymax" exact="3 * $delaymin"/>
          <wait min="($delaymin)s" max="($delaymax)s"/>

          <!-- Re-checked once more: this order could have been interrupted again during the wait itself. -->
          <do_if value="this.ship.exists and $anomaly.exists and this.ship.sector == $anomaly.sector and this.ship.relativeposition.{$anomaly}.length le $arrivaldistance">
            <set_value name="$hasjumped" exact="true"/>
            <perform_gate_transition object="this.ship" gate="$anomaly"/>
          </do_if>
        </do_if>
      </do_else>
    </actions>
  </attention>
</aiscript>
<?xml version="1.0" encoding="utf-8"?>
<mdscript name="OrderJumpAnomaly" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>

    <!--
      How big a radius around a navigation beacon (class.navbeacon) counts as
      "placed to mark an anomaly" - anomalies never show on the map, so a
      player-dropped beacon near one is the only precise, clickable stand-in.
      5km matches the range the player suggested; wide enough to cover a beacon
      dropped slightly off from the anomaly's exact position, narrow enough to
      not accidentally pick up an unrelated anomaly elsewhere in the sector.
    -->
    <cue name="OrderJumpAnomaly_Globals">
      <actions>
        <set_value name="OrderJumpAnomaly_Globals.$BeaconSearchRadius" exact="5km"/>
      </actions>
    </cue>

    <!--
      Listens for every interact menu (right-click) opening in the game and,
      if the target is a navigation beacon with an anomaly nearby and at least
      one player ship is selected, adds a custom action via SirNukes' Interact
      Menu API (md.Interact_Menu_API, part of sn_mod_support_apis). This is
      the only available hook for conditionally adding a right-click order
      without touching Egosoft's own menu lua - confirmed via
      sn_mod_support_apis' own Interact_Menu_API.xml doc comments
      (event.param.$object / $selectedplayerships / $showPlayerInteractions).
    -->
    <cue name="OrderJumpAnomaly_AddAction" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions"/>
      </conditions>
      <actions>
        <set_value name="$Target" exact="event.param.$object"/>
        <do_if value="$Target? and $Target.exists and $Target.isclass.{class.navbeacon} and event.param.$selectedplayerships? and event.param.$selectedplayerships.count gt 0">
          <find_object name="$Anomaly" class="class.anomaly" space="$Target.sector" multiple="false" required="false">
            <match_distance object="$Target" max="OrderJumpAnomaly_Globals.$BeaconSearchRadius"/>
          </find_object>
          <do_if value="$Anomaly? and $Anomaly.exists">
            <signal_cue_instantly
              cue="md.Interact_Menu_API.Add_Action"
              param="table[
                $id         = 'order_jump_anomaly_fly',
                $section    = 'order',
                $text       = {9000002, 10},
                $mouseover  = {9000002, 11},
                $icon       = 'order_movetoobject',
                $mouseover_icon = 'order_movetoobject',
                $callback   = OrderJumpAnomaly_Callback,
                $echo       = $Anomaly,
                ]"/>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <!--
      Fired when the player actually selects the action. Sends every
      currently selected player ship (not just a single one) towards the
      anomaly found earlier - handed through untouched via $echo, so we don't
      need to re-search for it and risk picking a different one.
    -->
    <cue name="OrderJumpAnomaly_Callback" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Anomaly" exact="event.param.$echo"/>
        <do_if value="$Anomaly? and $Anomaly.exists">
          <do_for_each name="$Ship" in="event.param.$selectedplayerships">
            <do_if value="$Ship? and $Ship.exists and $Ship.isclass.{class.ship}">
              <signal_cue_instantly cue="OrderJumpAnomaly_SendShip" param="table[$ship=$Ship, $anomaly=$Anomaly]"/>
            </do_if>
          </do_for_each>
        </do_if>
      </actions>
    </cue>

    <!--
      One instance per commanded ship. Queues a single custom JumpAnomaly
      order (aiscripts/order.jump.anomaly.xml), appended to whatever the
      ship's order queue already contains (eg. a manually clicked-together
      fly-here/do-that list) - not immediate, so this adds "then jump through
      the anomaly" at the end instead of shoving the ship's current order
      aside.

      JumpAnomaly itself flies the ship to the anomaly if needed (creating
      its own immediate MoveToObject sub-order first, same pattern as
      Egosoft's own DockAndWait/DockAt - see that script for why this needs
      to be re-validated on every restart rather than trusted as a one-off
      "get there" step done in advance). An earlier version queued
      MoveToObject here in MD as a separate, once-only order ahead of
      JumpAnomaly; that broke if the player inserted a manual order between
      the two, since JumpAnomaly only checked its position once and could
      end up jumping from wherever the inserted order had since taken the
      ship, rather than from the anomaly.
    -->
    <cue name="OrderJumpAnomaly_SendShip" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Ship" exact="event.param.$ship"/>
        <set_value name="$Anomaly" exact="event.param.$anomaly"/>
        <create_order object="$Ship" id="'JumpAnomaly'" comment="Appended to the order queue - flies to the anomaly if needed, then jumps">
          <param name="anomaly" value="$Anomaly"/>
        </create_order>
      </actions>
    </cue>

  </cues>
</mdscript>
<?xml version="1.0" encoding="utf-8"?>
<language id="44">
  <page id="9000002" title="Order Jump Anomaly - Custom Texts" descr="Custom interact menu texts added by the Order Jump Anomaly mod" voice="no">
    <!-- Interact menu action shown when right-clicking a nav beacon placed near an anomaly -->
    <t id="10">Jump through Anomaly</t>
    <t id="11">Fly to the nearby anomaly and jump through it.</t>
    <!-- Custom AI order queued after MoveToObject (aiscripts/order.jump.anomaly.xml) -->
    <t id="20">Jump through Anomaly</t>
    <t id="21">Fly to the nearby anomaly and jump through it.</t>
    <t id="22">Anomaly</t>
  </page>
</language>
<?xml version="1.0" encoding="utf-8"?>
<language id="49">
  <page id="9000002" title="Anomalie-Sprungbefehl - Eigene Texte" descr="Eigene Rechtsklickmenue-Texte des Mods 'Anomalie-Sprungbefehl'" voice="no">
    <!-- Rechtsklick-Aktion, wenn eine in der Naehe einer Anomalie platzierte Navigationsbake angewaehlt wird -->
    <t id="10">Durch Anomalie springen</t>
    <t id="11">Fliege zur nahegelegenen Anomalie und springe hindurch.</t>
    <!-- Eigene KI-Order, die nach MoveToObject angehaengt wird (aiscripts/order.jump.anomaly.xml) -->
    <t id="20">Durch Anomalie springen</t>
    <t id="21">Fliege zur nahegelegenen Anomalie und springe hindurch.</t>
    <t id="22">Anomalie</t>
  </page>
</language>
